# Configuration.
# Copy this file to .env and fill in the values.

# Port the app runs on.
PORT=3000

# Secret string used to sign the login cookie.
# Use a long random value. `openssl rand -hex 32` and paste it here.
SESSION_SECRET=change-me-to-a-long-random-string

# Username to log in to the dashboard. Defaults to "admin" if you leave it out.
ADMIN_USERNAME=admin

# Password to log in to the dashboard. Pick something only you know.
# Leave blank to disable login entirely. Required (non-empty) in production.
ADMIN_PASSWORD=

# Who is allowed to reach the app at all, including the login page.
# Leave blank to allow localhost only. Example: ALLOWED_IPS=203.0.113.10, 198.51.100.7
ALLOWED_IPS=

# Set to true only if the app runs behind a reverse proxy such as nginx.
# This lets the app see the real visitor IP instead of the proxy IP.
TRUST_PROXY=false

# Set to "production" for a live deployment. Enables the Secure session cookie and HSTS (requires HTTPS).
NODE_ENV=

# Key used to encrypt the OpenAI API key stored on the Settings page
# Must be 32 bytes: 64 hex chars or base64. Generate one with openssl rand -hex 32
SETTINGS_ENC_KEY=

# Your OpenAI API key. Optional here.
# If you set it, the app uses it until you save a key on the Settings page.
OPENAI_API_KEY=

# Which image model to start with: 1.5 means gpt-image-1.5, 2 means gpt-image-2.
OPENAI_MODEL=1.5

# How much room saved images may take, Saving is refused after limit
UPLOAD_QUOTA_MB=

# Largest single image the Upload page accepts, in megabytes. Blank for 10.
UPLOAD_MAX_MB=

# Largest image-plus-mask an edit may post, in megabytes. Two files travel
# together, so this is higher than an upload. Blank for 12.
EDIT_MAX_MB=

# Largest prompts file an import may read, in kilobytes. Blank for 1024.
IMPORT_MAX_KB=

# How many requests one address may make before it is denied
RATE_LIMIT_LOGIN_MAX=       # 10 per 15 minutes, against password guessing
RATE_LIMIT_GENERATE_MAX=    # 30 per minute, guarding the paid key
RATE_LIMIT_SAVE_MAX=        # 60 per minute
RATE_LIMIT_SHARE_MAX=       # 60 per minute, the public share routes
RATE_LIMIT_SHARE_ZIP_MAX=   # 5 per minute, the one public route that zips

# How many saved images the Generations page shows per page.
# Used only when the Settings page field is left blank. Defaults to 24.
GENERATIONS_PER_PAGE=

# White Label
# The icon is a Font Awesome 6 free class list, for example:
#   BRAND_ICON=fa-solid fa-camera
BRAND_NAME=
BRAND_ICON=

# Optional. Point the SDK at a different API root (for an OpenAI compatible service).
OPENAI_BASE_URL=

# Let anyone holding a share link open it, from any address.
# Leave blank or false and share links only work from an address on your allow list.
PUBLIC_SHARE=false

# Publish the gallery page listing every image you have shared.
PUBLIC_GALLERY=false

# Put the start of the prompt in share URLs, so a link reads
# /s/a-blue-sky-k3f9Qa72vX instead of /s/k3f9Qa72vX.
PUBLIC_SHARE_SLUG=false

# Let anyone holding a shared collection's link open it, from any address.
PUBLIC_COLLECTIONS=false

# Let anyone holding the favourites link open it, from any address.
PUBLIC_FAVOURITES=false

# Where the install files are
# Leave them blank and the app uses data/imageforge.db, public/uploads and data/backups.
#
IMAGEFORGE_DB=
IMAGEFORGE_UPLOADS=
IMAGEFORGE_BACKUPS=
