<%- include('partials/header') %>
<%- include('partials/page-head-end') %>

<div class="mb-6">
  <a href="<%= pages.prompts %>" class="text-sm text-slate-500 hover:text-slate-800">&larr; Back to prompts</a>
</div>

<div class="<%= mode === 'edit' ? 'grid grid-cols-1 gap-6 lg:grid-cols-[2fr_1fr]' : 'max-w-2xl' %>">
  <form action="<%= action %>" method="post" class="card">
    <div class="card-head"><%- include('partials/icon', { name: 'fa-regular fa-pen-to-square' }) %><h2>The prompt</h2></div>
    <div class="card-body space-y-5">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <% if (error) { %>
      <div class="notice notice-error">
        <%- include('partials/icon', { name: 'fa-solid fa-circle-exclamation' }) %>
        <span><%= error %></span>
      </div>
    <% } %>
    <div>
      <label for="name" class="field-label">Name</label>
      <input id="name" name="name" type="text" required value="<%= prompt.name %>" placeholder="A short name for this prompt"
        class="w-full rounded-md border border-slate-300 px-3 py-2 focus:border-brand-500 focus:outline-none" />
    </div>

    <div>
      <label for="category_id" class="field-label">Category</label>
      <select id="category_id" name="category_id"
        class="w-full rounded-md border border-slate-300 px-3 py-2 focus:border-brand-500 focus:outline-none">
        <option value="">Uncategorised</option>
        <% categories.forEach(function (category) { %>
          <option value="<%= category.id %>" <%= String(prompt.category_id || '') === String(category.id) ? 'selected' : '' %>><%= category.name %></option>
        <% }); %>
      </select>
      <p class="help">Manage the list on the Categories page.</p>
    </div>

    <div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="default_size" class="field-label">Preferred size</label>
          <select id="default_size" name="default_size"
            class="w-full rounded-md border border-slate-300 px-3 py-2 focus:border-brand-500 focus:outline-none">
            <option value="">Use the app default</option>
            <% sizes.forEach(function (size) { %>
              <option value="<%= size %>" <%= prompt.default_size === size ? 'selected' : '' %>><%= size %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label for="default_model" class="field-label">Preferred model</label>
          <select id="default_model" name="default_model"
            class="w-full rounded-md border border-slate-300 px-3 py-2 focus:border-brand-500 focus:outline-none">
            <option value="">Use the app default</option>
            <% modelTokens.forEach(function (token) { %>
              <option value="<%= token %>" <%= prompt.default_model === token ? 'selected' : '' %>><%= modelIds[token] %></option>
            <% }); %>
          </select>
        </div>
      </div>
      <p class="help">Filled in automatically when you pick this prompt on the Generate page.</p>
    </div>

    <div>
      <label for="prompt" class="field-label">Prompt text</label>
      <textarea id="prompt" name="prompt" rows="7" required placeholder="Describe the image you want."
        class="w-full resize-y rounded-md border border-slate-300 px-3 py-2 focus:border-brand-500 focus:outline-none"><%= prompt.prompt %></textarea>
      <p data-char-count="prompt" class="mt-1 text-right text-xs text-slate-400"></p>
    </div>

    <div>
      <label for="notes" class="field-label">
        Notes <span class="font-normal text-slate-400">(optional)</span>
      </label>
      <textarea id="notes" name="notes" rows="3" placeholder="What this prompt is for, or what to change next time."
        class="w-full resize-y rounded-md border border-slate-300 px-3 py-2 focus:border-brand-500 focus:outline-none"><%= prompt.notes || '' %></textarea>
      <p class="help">Only for you. Searched along with the name and the prompt text.</p>
    </div>

    <div class="flex items-center gap-3 pt-1">
      <button type="submit" class="btn btn-primary">
        <%= mode === 'edit' ? 'Save changes' : 'Save prompt' %>
      </button>
      <a href="<%= pages.prompts %>" class="btn btn-quiet">Cancel</a>
    </div>
    </div>
  </form>

  <% if (mode === 'edit') { %>
    <div class="flex flex-col gap-6">
      <%- include('partials/prompt-form/rating', { prompt: prompt }) %>
      <%- include('partials/prompt-form/images', { prompt: prompt, madeFrom: madeFrom || [], madeFromTotal: madeFromTotal }) %>
      <%- include('partials/prompt-form/pin', { prompt: prompt }) %>
    </div>
  <% } %>
</div>

<%- include('partials/page-scripts', {
      scripts: mode === 'edit'
        ? ['char-count', 'api', 'rating', 'pin-order', 'pin']
        : ['char-count'],
    }) %>

<%- include('partials/chrome-foot') %>
