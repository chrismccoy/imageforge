<div id="prompt-modal" hidden class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4">
  <div class="w-full max-w-lg overflow-hidden rounded-xl bg-white shadow-xl">
    <div class="flex items-center justify-between border-b border-slate-200 px-5 py-3">
      <h2 class="text-sm font-semibold text-slate-800">Prompt</h2>
      <button type="button" data-prompt-close aria-label="Close"
        class="text-xl leading-none text-slate-400 hover:text-slate-700">&times;</button>
    </div>
    <div class="max-h-80 overflow-y-auto px-5 py-4">
      <p id="prompt-modal-text" class="whitespace-pre-wrap break-words text-sm text-slate-700"></p>
    </div>
    <div class="flex items-center justify-end gap-2 border-t border-slate-200 px-5 py-3">
      <button type="button" id="prompt-modal-copy"
        class="rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">Copy</button>
      <button type="button" data-prompt-close
        class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Close</button>
    </div>
  </div>
</div>
