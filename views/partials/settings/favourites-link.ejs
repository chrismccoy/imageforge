<section class="card">
  <div class="card-head"><%- include('../icon', { name: 'fa-solid fa-star' }) %><h2>The favourites link</h2></div>
  <div class="card-body">

  <% if (settings.favourites_token) { %>
    <% const favUrl = favouritesPrefix + '/' + settings.favourites_token; %>
    <div class="flex flex-wrap items-center gap-3">
      <span class="pill pill-green">
        <%- include('../icon', { name: 'fa-solid fa-circle-check' }) %> Shared
      </span>
      <a href="<%= favUrl %>" class="font-mono text-xs text-brand-600 hover:underline"><%= favUrl %></a>
      <button type="button" data-copy="<%= favUrl %>" aria-label="Copy the link"
        class="inline-flex h-6 w-6 items-center justify-center rounded text-slate-400 hover:bg-slate-100 hover:text-slate-700">
        <%- include('../icon', { name: 'fa-regular fa-copy' }) %>
      </button>
    </div>
    <p class="help">
      Anyone with this link sees every starred image, whether or not each one is shared on its own.
      Un-sharing kills it at once, and sharing again gives a different link.
    </p>
    <form action="<%= pages.settings %>/favourites/unshare" method="post" class="mt-2.5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button type="submit" class="btn btn-quiet btn-sm">
        <%- include('../icon', { name: 'fa-solid fa-link-slash' }) %> Un-share
      </button>
    </form>
  <% } else { %>
    <p class="text-sm text-slate-600">
      One link showing every image you have starred. Nothing is public until you create it.
    </p>
    <form action="<%= pages.settings %>/favourites/share" method="post" class="mt-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button type="submit" class="btn btn-quiet btn-sm">
        Create the link
      </button>
    </form>
  <% } %>
  </div>
</section>
