<% if (totalPages > 1) { %>
  <nav class="mt-8 flex items-center justify-center gap-2 text-sm text-slate-500">
    <% if (page > 1) { %>
      <a href="<%= prevUrl %>" class="btn btn-quiet">
        <%- include('icon', { name: 'fa-solid fa-chevron-left' }) %> Previous
      </a>
    <% } else { %>
      <span class="btn btn-quiet btn-disabled">
        <%- include('icon', { name: 'fa-solid fa-chevron-left' }) %> Previous
      </span>
    <% } %>

    <span class="px-2">Page <%= page %> of <%= totalPages %></span>

    <% if (page < totalPages) { %>
      <a href="<%= nextUrl %>" class="btn btn-quiet">
        Next <%- include('icon', { name: 'fa-solid fa-chevron-right' }) %>
      </a>
    <% } else { %>
      <span class="btn btn-quiet btn-disabled">
        Next <%- include('icon', { name: 'fa-solid fa-chevron-right' }) %>
      </span>
    <% } %>
  </nav>
<% } %>
