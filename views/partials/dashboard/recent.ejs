<section data-widget="recent" class="card lg:col-span-2">
  <div class="card-head">
    <h2>Recent</h2>
    <a href="<%= pages.generations %>" class="ml-auto text-xs text-brand-600 hover:underline">All images</a>
  </div>
  <div class="card-body">
    <% if (recent.length) { %>
      <div class="grid grid-cols-3 gap-3 sm:grid-cols-6">
        <% recent.forEach(function (image) { %>
          <a href="<%= pages.generate %>?from=<%= image.id %>" title="<%= image.prompt %>"
            class="block overflow-hidden rounded-lg border border-slate-200 hover:border-brand-500">
            <img src="<%= uploadPrefix %>/<%= image.filename %>" alt="<%= image.prompt %>" loading="lazy"
              class="aspect-square w-full object-cover" />
          </a>
        <% }); %>
      </div>
      <p class="mt-3 text-xs text-slate-500">Click one to generate from it again.</p>
    <% } else { %>
      <p class="card-empty">Nothing generated yet.</p>
      <p class="text-center"><a href="<%= pages.generate %>" class="text-sm text-brand-600 hover:underline">Generate your first image</a></p>
    <% } %>
  </div>
</section>
