<section data-widget="output" class="card lg:col-span-2">
  <div class="card-head">
    <%- include('../icon', { name: 'fa-solid fa-chart-column', extra: 'text-slate-400' }) %>
    <h2>Output</h2>
    <span class="ml-auto text-xs font-medium text-slate-500">Last <%= output.days %> days</span>
  </div>
  <div class="card-body">
    <svg viewBox="0 0 <%= output.bars.length * 20 %> <%= output.height + 14 %>" preserveAspectRatio="none"
      class="block h-32 w-full" role="img"
      aria-label="Images generated per day over the last <%= output.days %> days">
      <% output.bars.forEach(function (bar, index) { %>
        <rect x="<%= index * 20 + 2 %>" y="<%= output.height - bar.height %>" width="14"
          height="<%= bar.height %>" rx="2" class="fill-brand-500 hover:fill-brand-700">
          <title><%= bar.day %>: <%= bar.images %></title>
        </rect>
      <% }); %>
    </svg>
    <div class="mt-3 flex flex-wrap items-center gap-4 border-t border-slate-100 pt-3 text-xs text-slate-500">
      <span><b class="font-semibold tabular-nums text-slate-900"><%= output.images %></b> images</span>
      <% if (output.spend) { %><span><b class="font-semibold tabular-nums text-slate-900"><%= output.spend %></b> spent</span><% } %>
      <span><b class="font-semibold tabular-nums text-slate-900"><%= output.perDay %></b> per day</span>
    </div>
  </div>
</section>
