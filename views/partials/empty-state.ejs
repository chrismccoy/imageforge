<%
  
  const noteText = locals.note ?? null;
  const linkObj = locals.link ?? null;
  const isLive = Boolean(locals.live);
  const isHidden = Boolean(locals.hide);
%>
<div class="empty text-slate-400"<% if (isLive) { %> data-empty-state<% } %><% if (isHidden) { %> hidden<% } %>>
  <%- include('icon', { name: icon, extra: 'text-5xl text-slate-300' }) %>
  <p class="mt-3 text-sm text-slate-500"><%= text %></p>
  <% if (noteText) { %>
    <p class="mt-1 text-sm"><%= noteText %></p>
  <% } %>
  <% if (linkObj) { %>
    <a href="<%= linkObj.href %>" class="mt-3 inline-block text-sm text-brand-600 hover:underline"><%= linkObj.label %></a>
  <% } %>
</div>
