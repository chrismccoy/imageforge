{
  "name": "imageforge",
  "version": "1.0.0",
  "description": "Generate images with OpenAI from a simple admin dashboard. Save reusable prompts, preview, and save generations locally.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "build": "tailwindcss -i ./src/tailwind.css -o ./public/css/app.css --minify",
    "build:screenshots": "tailwindcss -c ./tailwind.screenshots.config.js -i ./src/screenshots.css -o ./screenshots/gallery.css --minify",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test-report": "node --test --test-reporter=./scripts/minimal-reporter.js \"tests/**/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "multer": "^2.2.0",
    "openai": "^7.3.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19"
  }
}
